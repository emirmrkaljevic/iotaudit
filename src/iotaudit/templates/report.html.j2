<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>iotaudit report</title>
<style>
body{font-family:system-ui,sans-serif;max-width:960px;margin:2rem auto;padding:0 1rem;color:#1d1d1f}
h1{margin-bottom:.2rem}.muted{color:#666;font-size:.9rem}
.card{border:1px solid #ddd;border-radius:10px;padding:1rem 1.2rem;margin:1.2rem 0}
.grade{float:right;font-size:2.6rem;font-weight:700;width:3.6rem;height:3.6rem;line-height:3.6rem;
text-align:center;border-radius:10px;color:#fff}
.gA{background:#1a7f37}.gB{background:#4c9a2a}.gC{background:#c69026}.gD{background:#d4691c}
.gE{background:#c2410c}.gF{background:#b91c1c}
table{border-collapse:collapse;width:100%;font-size:.9rem}td,th{border-bottom:1px solid #eee;
padding:.35rem;text-align:left;vertical-align:top}
.high{color:#b91c1c;font-weight:600}.medium{color:#c2410c}.low{color:#666}
.tag{display:inline-block;padding:0 .4rem;border-radius:4px;font-size:.8rem;background:#eee}
</style></head><body>
<h1>iotaudit report</h1>
<p class="muted">Generated {{ generated }} &middot; iotaudit {{ version }}{% if meta.source %} &middot; source: {{ meta.source }}{% endif %}{% if meta.duration %} &middot; capture {{ meta.duration }}s{% endif %}</p>
<p class="muted">Findings are indicators based on observed traffic, not proof of wrongdoing by any vendor.
All data was processed locally.</p>
{% for d in devices %}
<div class="card">
  <div class="grade g{{ d.grade }}">{{ d.grade }}</div>
  <h2>{{ d.ip }}</h2>
  <p class="muted">MAC {{ d.mac or "?" }} &middot; {{ d.vendor or "unknown vendor" }}
  {% if d.profile %}&middot; profile: {{ d.profile }}{% endif %} &middot; score {{ d.score }}/100</p>
  <h3>Findings</h3>
  {% if d.findings %}<ul>{% for f in d.findings %}
    <li><span class="{{ f.severity }}">[{{ f.severity }}]</span> <b>{{ f.title }}</b> &mdash; {{ f.detail }}{% if f.confidence and f.confidence != "certain" %} <span class="tag">confidence: {{ f.confidence }}</span>{% endif %}</li>
  {% endfor %}</ul>{% else %}<p>No issues observed.</p>{% endif %}
  <h3>Destinations</h3>
  <table><tr><th>Domain(s)</th><th>IP</th><th>Country</th><th>Organisation</th><th>Ports</th><th>Bytes out</th><th>Encrypted</th></tr>
  {% for x in d.destinations %}<tr>
    <td>{{ x.domains|join(", ") or "&mdash;"|safe }}{% if x.tracker %} <span class="tag">tracker</span>{% endif %}{% if x.expected == False %} <span class="tag">unexpected</span>{% endif %}</td>
    <td>{{ x.ip }}</td><td>{{ x.country or "?" }}</td><td>{{ x.org or "?" }}</td>
    <td>{{ x.ports|join(", ") }}{% if x.protocols %} ({{ x.protocols|join(", ") }}){% endif %}</td><td>{{ x.bytes_out }}</td>
    <td>{% if x.encrypted %}yes{% else %}<span class="high">NO</span>{% endif %}</td></tr>{% endfor %}
  </table>
  {% if d.open_ports %}<h3>Open ports (LAN)</h3>
  <table><tr><th>Port</th><th>Service</th><th>Product</th><th>Risk</th></tr>
  {% for p in d.open_ports %}<tr><td>{{ p.port }}/{{ p.proto }}</td><td>{{ p.service }}</td><td>{{ p.product }}</td>
  <td class="{{ p.risk }}">{{ p.risk or "" }}</td></tr>{% endfor %}</table>{% endif %}
</div>
{% else %}<p>No devices observed.</p>{% endfor %}
</body></html>
